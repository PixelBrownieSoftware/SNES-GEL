// Streams a packed level into the BG2 tilemap ring at VRAM word $4000.
// The caller supplies cam_x/cam_y, initializes while blanked, and streams in VBlank.
// The camera must remain inside level_left/level_top's loaded coverage.
// Include level-data.gel first; the level uses 8x8 tiles and a 256x224 viewport.
u16 level_top = 0;
u16 level_left = 0;
u8 level_stream_ready = 0;
#define STREAM_ROWS_PER_FRAME 5

fn level_load_row(u16 r) {
    if (LEVEL_BANKED) {
        u16 x = level_left;
        u16 remaining = 64;
        if (LEVEL_WIDTH == 32) { remaining = 32; }
        while (remaining > 0) {
            u16 count = 32 - (x & 31);
            if (count > remaining) { count = remaining; }
            u16 chunk = level_chunk_index(x, r);
            u8 bank = LEVEL_MAP_BANK + (chunk >> 4);
            u16 target = 0x4000 + (((x >> 5) & 1) << 10) + ((r & 31) << 5) + (x & 31);
            u16 source = LEVEL_MAP + ((chunk & 15) << 11) + ((r & 31) << 6) + ((x & 31) << 1);
            std_load_vram_far(target, bank, source, count << 1);
            x += count;
            remaining -= count;
        }
        return 0;
    }
    u16 page = 0;
    while (page < LEVEL_PAGES) {
        std_load_vram_far(0x4000 + (page << 10) + ((r & 31) << 5), LEVEL_BANK,
                          LEVEL_MAP + page * LEVEL_PAGE_BYTES + (r << 6), 64);
        page++;
    }
}

mmio u16 stream_pointer @ 0x0004;
mmio u8 stream_bank @ 0x0006;
mmio u16 stream_count @ 0x0008;

// A column is split at the VRAM ring boundary; the ROM source advances one row at a time.
fn level_load_column_part(u16 x, u16 y, u16 count) {
    u16 chunk = level_chunk_index(x, y);
    VMAIN = 0x81;
    VMADDL = 0x4000 + (((x >> 5) & 1) << 10) + ((y & 31) << 5) + (x & 31);
    stream_count = count;
    stream_pointer = LEVEL_MAP + ((chunk & 15) << 11) + ((y & 31) << 6) + ((x & 31) << 1);
    stream_bank = LEVEL_MAP_BANK + (chunk >> 4);
    asm {
        REP #$30
        LDX $08
        LDY #$0000
    -   LDA [$04],Y
        STA $2118
        TYA
        CLC
        ADC #$0040
        TAY
        DEX
        BNE -
    }
}

fn level_load_column(u16 x) {
    u16 count = 32 - (level_top & 31);
    level_load_column_part(x, level_top, count);
    if (count < 32) {
        level_load_column_part(x, level_top + count, 32 - count);
    }
}

fn level_want_left() {
    if (!LEVEL_BANKED || LEVEL_WIDTH == 32) { return 0; }
    u16 want = cam_x >> 3;
    if (want > 16) { want -= 16; } else { want = 0; }
    if (want > LEVEL_WIDTH - 64) { want = LEVEL_WIDTH - 64; }
    return want;
}

fn level_want_top() {
    u16 want = cam_y >> 3;
    if (want > 0) { want -= 1; }
    if (want > LEVEL_MAX_TOP) { want = LEVEL_MAX_TOP; }
    return want;
}

fn level_stream_clamp_x(u16 x) {
    if (LEVEL_BANKED && level_stream_ready) {
        u16 min_x = level_left << 3;
        u16 max_x = (level_left + 32) << 3;
        if (LEVEL_WIDTH == 32) { max_x = 0; }
        if (x < min_x) { x = min_x; }
        if (x > max_x) { x = max_x; }
    }
    return x;
}

fn level_stream_clamp_y(u16 y) {
    if (LEVEL_BANKED && level_stream_ready) {
        u16 min_y = level_top << 3;
        u16 max_y = (level_top + 4) << 3;
        if (y < min_y) { y = min_y; }
        if (y > max_y) { y = max_y; }
    }
    return y;
}

// Fills the whole ring. Call with the screen blanked.
fn level_stream_init() {
    level_top = level_want_top();
    level_left = level_want_left();
    u16 r = 0;
    while (r < 32) {
        level_load_row(level_top + r);
        r++;
    }
    level_stream_ready = 1;
}

// Call during VBlank, before setting the scroll registers.
fn level_stream() {
    u16 want = level_want_top();
    u8 budget = STREAM_ROWS_PER_FRAME;
    while (level_top != want) {
        if (budget == 0) { return 0; }
        if (LEVEL_BANKED) {
            u16 line = std_vcount();
            if (line < 225 || line > 235) { return 0; }
        }
        budget--;
        if (level_top < want) {
            level_load_row(level_top + 32);
            level_top++;
        } else {
            level_top--;
            level_load_row(level_top);
        }
    }
    if (LEVEL_BANKED) {
        u16 left = level_want_left();
        while (level_left != left) {
            if (budget == 0) { return 0; }
            u16 line = std_vcount();
            if (line < 225 || line > 235) { return 0; }
            budget--;
            if (level_left < left) {
                level_load_column(level_left + 64);
                level_left++;
            } else {
                level_left--;
                level_load_column(level_left);
            }
        }
    }
}
