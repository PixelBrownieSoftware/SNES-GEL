// ---------------- Player controller ----------------
// Included by game.gel. Each ability is its own small function, switched on by a bit in
// player_abilities, so a "character" is just a different set of flags.

#define ABIL_MULTIJUMP  1
#define ABIL_DASH       2
#define ABIL_GLIDE      4
#define ABIL_POUND      8
#define ABIL_CLIMB      16

#define MULTIJUMP_EXTRA 2
#define MULTIJUMP_SPEED 4.4
#define GLIDE_FALL_SPEED 0.8
#define POUND_SPEED     7.0
#define CLIMB_SPEED     1.0
#define WALL_JUMP_LOCK  12

enum Character {
    CHAR_JUMPER,
    CHAR_DASHER,
    CHAR_GLIDER,
    CHAR_POUNDER,
    CHAR_CLIMBER
};

#define player_char       Entities[0].charid
#define player_abilities  Entities[0].abil
// Air actions (extra jumps / dash) used since last touching the ground.
#define air_actions       Entities[0].air
// Frames during which the wall can't be re-grabbed after a wall jump.
#define wall_lock         Entities[0].wall
// This whole thing will hold a bit for:
// HORIZONTAL PRESSED
// VERTICAL PRESSED
// HORIZONTAL DIRECTION
// VERTICAL DIRECTION
//Woah... that fit the SNES controller perfectly
#define INPUT_HORIZONTAL_PRESSED  0
#define INPUT_VERTICAL_PRESSED    1
#define INPUT_HORIZONTAL_DIR      2//Left = 1, Right = 0
#define INPUT_VERTICAL_DIR        3//Up = 1, Down = 0
#define INPUT_ACTION_PRESSED      4//A
#define INPUT_ACTION2_PRESSED     5//B
#define INPUT_ACTION3_PRESSED     6//X
#define INPUT_ACTION4_PRESSED     7//Y
#define INPUT_ACTION_RELEASED     8//A
#define INPUT_ACTION2_RELEASED    9//B
#define INPUT_ACTION3_RELEASED    10//X
#define INPUT_ACTION4_RELEASED    11//Y
#define INPUT_ACTION_PUSHED     12//A
#define INPUT_ACTION2_PUSHED    13//B
#define INPUT_ACTION3_PUSHED    14//X
#define INPUT_ACTION4_PUSHED    15//Y
u16 input_presses = 0;

fn set_character(u8 c) {
    player_char = c;
    switch (c) {
        case CHAR_JUMPER:  player_abilities = ABIL_MULTIJUMP; break;
        case CHAR_DASHER:  player_abilities = ABIL_DASH;      break;
        case CHAR_GLIDER:  player_abilities = ABIL_GLIDE;     break;
        case CHAR_POUNDER: player_abilities = ABIL_POUND;     break;
        case CHAR_CLIMBER: player_abilities = ABIL_CLIMB;     break;
    }
}

// ---- Horizontal movement ----
fn update_dash(u16 e) {
    
    
    i8 v = vert_input(input_presses);
    Entities[e].vx = DASH_SPEED * Entities[e].dirx;
    Entities[e].vy = 0.0 + v * (PLAYER_MAX_SPEED / 1.5);
    dash_frames--;
    if (dash_frames == 0) {
        // Exit with some leftover speed that bleeds off, instead of a hard stop.
        Entities[e].vx = DASH_EXIT_SPEED * Entities[e].dirx;
    
    }

}

fn vert_input(u8 input) -> i8 {
    i8 v = 0;
    //Bit test for vertical input
    //Dude just have a look at todo.md
    if (bit_test(input, INPUT_VERTICAL_PRESSED)) {
        // Vertical input was pressed
        if (bit_test(input, INPUT_VERTICAL_DIR)) {
            v = -1;
        } else {
            v = 1;
        }
    }
    return v;
}
fn horiz_input(u8 input) -> i8 {
    i8 h = 0;
    //Bit test for horizontal input
    //Dude just have a look at todo.md
    if (bit_test(input, INPUT_HORIZONTAL_PRESSED)) {
        // Horizontal input was pressed
        if (bit_test(input, INPUT_HORIZONTAL_DIR)) {
            h = -1;
        } else {
            h = 1;
        }
    }
    return h;
}

fn poll_input() {
    // --- Horizontal Movement ---
    if (pad1_held & BTN_LEFT || pad1_held & BTN_RIGHT) {
        bit_set(input_presses, INPUT_HORIZONTAL_PRESSED);
        if (pad1_held & BTN_LEFT) {
            bit_set(input_presses, INPUT_HORIZONTAL_DIR);
        } else if (pad1_held & BTN_RIGHT) {
            bit_clear(input_presses, INPUT_HORIZONTAL_DIR);
        }
    } else {
        bit_clear(input_presses, INPUT_HORIZONTAL_PRESSED);
    }

    // --- Vertical Movement ---
    if (pad1_held & BTN_UP || pad1_held & BTN_DOWN) {
        bit_set(input_presses, INPUT_VERTICAL_PRESSED);
        if (pad1_held & BTN_UP) {
            bit_set(input_presses, INPUT_VERTICAL_DIR);
        } else if (pad1_held & BTN_DOWN) {
            bit_clear(input_presses, INPUT_VERTICAL_DIR);
        }
    } else {
        bit_clear(input_presses, INPUT_VERTICAL_PRESSED);
    }

    // --- Action Button A ---
    if (pad1_held & BTN_A) {
        bit_set(input_presses, INPUT_ACTION_PRESSED);
        bit_clear(input_presses, INPUT_ACTION_RELEASED);
    } else {
        bit_clear(input_presses, INPUT_ACTION_PRESSED);
        bit_set(input_presses, INPUT_ACTION_RELEASED);
    }
    if (pad1_pressed & BTN_A) {
        bit_set(input_presses, INPUT_ACTION_PUSHED);
    } else {
        bit_clear(input_presses, INPUT_ACTION_PUSHED);
    }

    // --- Action Button B ---
    if (pad1_held & BTN_B) {
        bit_set(input_presses, INPUT_ACTION2_PRESSED);
        bit_clear(input_presses, INPUT_ACTION2_RELEASED);
    } else {
        bit_clear(input_presses, INPUT_ACTION2_PRESSED);
        bit_set(input_presses, INPUT_ACTION2_RELEASED);
    }
    if (pad1_pressed & BTN_B) {
        bit_set(input_presses, INPUT_ACTION2_PUSHED);
    } else {
        bit_clear(input_presses, INPUT_ACTION2_PUSHED);
    }

    // --- Action Button X ---
    if (pad1_held & BTN_X) {
        bit_set(input_presses, INPUT_ACTION3_PRESSED);
        bit_clear(input_presses, INPUT_ACTION3_RELEASED);
    } else {
        bit_clear(input_presses, INPUT_ACTION3_PRESSED);
        bit_set(input_presses, INPUT_ACTION3_RELEASED);
    }
    if (pad1_pressed & BTN_X) {
        bit_set(input_presses, INPUT_ACTION3_PUSHED);
    } else {
        bit_clear(input_presses, INPUT_ACTION3_PUSHED);
    }

    // --- Action Button Y ---
    if (pad1_held & BTN_Y) {
        bit_set(input_presses, INPUT_ACTION4_PRESSED);
        bit_clear(input_presses, INPUT_ACTION4_RELEASED);
    } else {
        bit_clear(input_presses, INPUT_ACTION4_PRESSED);
        bit_set(input_presses, INPUT_ACTION4_RELEASED);
    }
    if (pad1_pressed & BTN_Y) {
        bit_set(input_presses, INPUT_ACTION4_PUSHED);
    } else {
        bit_clear(input_presses, INPUT_ACTION4_PUSHED);
    }
}


//This would need to be put in the entites system
//Instead of pad1_held booleans, we would have a general input system for entities.
//i.e. horiz_input and vert_input to check if those buttons were pressed
//This function will not know or care about the specific input source; it will just respond to the input state provided by the entity system.
fn update_run(u16 e) {
    if (bit_test(mode_flags, MODE_FLAG_POUNDING)) {
        Entities[e].vx = 0.0;
        return 0;
    }
    i8 h = horiz_input(input_presses);
    if (bit_test(input_presses, INPUT_HORIZONTAL_PRESSED)) {
        Entities[e].vx += h * PLAYER_ACCEL;
        //Use whatever is the equivalent of abs() in GEL
        Entities[e].vx += h * FRICTION;
        Entities[e].vx = clamp(Entities[e].vx, -PLAYER_MAX_SPEED, PLAYER_MAX_SPEED);
        if (h < 0) {
            bit_set(mode_flags, MODE_FLAG_DIRECTION);
        } else {
            bit_clear(mode_flags, MODE_FLAG_DIRECTION);
        }
    } else{
        
        if (abs(Entities[e].vx) > FRICTION) {
            Entities[e].vx += -sign(Entities[e].vx) * FRICTION;
        } else {
            Entities[e].vx = 0.0;
        }
    }

    
    if (Entities[e].vx == 0.0) {
        Entities[e].state = STATE_IDLE;
    } else {
        Entities[e].state = STATE_MOVING;
    }
}

fn play_jump_sound() {
    std_sfx_play(player_jump_sfx, 15, 8, 6);
}

fn update_footstep_sound(u16 e) {
    if (game_mode != MODE_PLATFORMER ||
        !bit_test(mode_flags, MODE_FLAG_ON_GROUND) ||
        Entities[e].state != STATE_MOVING ||
        Entities[e].vx == 0.0) {
        footstep_timer = 0;
        return 0;
    }

    footstep_timer++;
    if (footstep_timer >= 18) {
        footstep_timer = 0;
        switch (footstep_index) {
            case 0: std_sfx_play(player_footstep_sfx1, 15, 8, 8); break;
            case 1: std_sfx_play(player_footstep_sfx2, 15, 8, 8); break;
            case 2: std_sfx_play(player_footstep_sfx3, 15, 8, 8); break;
            case 3: std_sfx_play(player_footstep_sfx4, 15, 8, 8); break;
            case 4: std_sfx_play(player_footstep_sfx5, 15, 8, 8); break;
        }
        footstep_index++;
        if (footstep_index >= 5) {
            footstep_index = 0;
        }
    }
}

// ---- Abilities ----
fn start_dash(u16 e) {
    Entities[e].vy = 0.0;
    std_sfx_play(player_dash_sfx, 15, 8, 4);
    if (bit_test(mode_flags, MODE_FLAG_DIRECTION)) {
        Entities[e].vx = -DASH_SPEED;
    } else {
        Entities[e].vx = DASH_SPEED;
    }
    Entities[e].dash = DASH_DURATION;
    Entities[e].state = STATE_DASHING;
}

// B pressed while airborne.
fn air_action(u16 e) {
    if (player_abilities & ABIL_MULTIJUMP) {
        if (air_actions < MULTIJUMP_EXTRA) {
            Entities[e].vy = -MULTIJUMP_SPEED;
            air_actions++;
            play_jump_sound();
        }
    }
    if (player_abilities & ABIL_DASH) {
        if (air_actions < 1) {
            start_dash(e);
            air_actions++;
        }
    }
}

// Holding B while falling slows the descent.
fn apply_glide(u16 e, u8 input) {
    if (player_abilities & ABIL_GLIDE) {
        if (bit_test(input, INPUT_ACTION2_PRESSED)) {
            if (Entities[e].vy > GLIDE_FALL_SPEED) {
                Entities[e].vy = GLIDE_FALL_SPEED;
            }
        }
    }
}

fn try_ground_pound(u16 e, u8 input) {
    if (player_abilities & ABIL_POUND) {
        if (vert_input(input) > 0) {
            bit_set(mode_flags, MODE_FLAG_POUNDING);
            Entities[e].vy = 0.0;
            Entities[e].vy = POUND_SPEED;
        }
    }
}

// Grab the wall you are pushing into. Returns 1 while attached.
fn update_climb(u16 e, u8 input) {
    i8 hdir = horiz_input(input);
    i8 vdir = vert_input(input);
    bit_clear(mode_flags, MODE_FLAG_CLIMBING);
    if (wall_lock > 0) {
        wall_lock--;
        return 0;
    }
    if (!(player_abilities & ABIL_CLIMB)) { return 0; }
    u8 touching = 0;
    if (hdir > 0) {
        if (hit_right(e)) { touching = 1; }
    }
    if (hdir < 0) {
        if (hit_left(e)) { touching = 1; }
    }
    if (touching == 0) { return 0; }

    bit_set(mode_flags, MODE_FLAG_CLIMBING);
    Entities[e].vy = 0.0;
    if (vdir < 0) {
        Entities[e].vy = -CLIMB_SPEED;
    } else if (vdir > 0) {
        Entities[e].vy = CLIMB_SPEED;
    }
    if (bit_test(input_presses, INPUT_ACTION2_PUSHED)) {
        // Kick away from the wall.
        Entities[e].vy = -JUMP_SPEED;
        play_jump_sound();
        wall_lock = WALL_JUMP_LOCK;
        bit_clear(mode_flags, MODE_FLAG_CLIMBING);
        if (bit_test(mode_flags, MODE_FLAG_DIRECTION)) {
            Entities[e].vx = PLAYER_MAX_SPEED;
            bit_clear(mode_flags, MODE_FLAG_DIRECTION);
        } else {
            Entities[e].vx = -PLAYER_MAX_SPEED;
            bit_set(mode_flags, MODE_FLAG_DIRECTION);
        }
    }
    return 1;
}

// ---- Vertical movement ----
fn update_platformer(u16 e) {
    if (hit_down(e)) {
        if (!bit_test(mode_flags, MODE_FLAG_ON_GROUND)) {
            std_sfx_play(player_land_sfx, 15, 8, 5);
            footstep_timer = 0;
        }
        bit_set(mode_flags, MODE_FLAG_ON_GROUND);
        bit_clear(mode_flags, MODE_FLAG_POUNDING);
        air_actions = 0;
    } else {
        bit_clear(mode_flags, MODE_FLAG_ON_GROUND);
    }

   if (bit_test(input_presses, INPUT_ACTION4_PUSHED)){
        player_char++;
        if (player_char > CHAR_CLIMBER) {
            player_char = CHAR_JUMPER;
        }
        set_character(player_char);
    }

    if (!bit_test(mode_flags, MODE_FLAG_ON_GROUND)) {
        if (update_climb(e, input_presses)) {
            return 0;
        }
    }

    if (Entities[e].state != STATE_DASHING || dash_frames == 0) {
        Entities[e].vy += GRAVITY * player_air_res;
    }
    if (!bit_test(mode_flags, MODE_FLAG_POUNDING)) {
        if (Entities[e].vy > MAX_FALL) {
            Entities[e].vy = MAX_FALL;
        }
    }

    if (bit_test(input_presses, INPUT_ACTION2_PUSHED)) {
        if (bit_test(mode_flags, MODE_FLAG_ON_GROUND)) {
            Entities[e].vy = -JUMP_SPEED;
            play_jump_sound();
        } else {
            air_action(e);
        }
    }
    if (!bit_test(mode_flags, MODE_FLAG_ON_GROUND)) {
        try_ground_pound(e, input_presses);
        apply_glide(e, input_presses);
    }

    if (Entities[e].vy >= 0.0) {
        bouncing = 0;
    }
    // Releasing jump early gives a short hop.
    if (Entities[e].vy < -JUMP_CUT_SPEED) {
        if (bit_test(input_presses, INPUT_ACTION2_RELEASED)) {
            if (!bouncing) {
                Entities[e].vy = -JUMP_CUT_SPEED;
            }
        }
    }
}

fn update_topdown(u16 e) {
    i8 v = vert_input(input_presses);
    if (bit_test(input_presses, INPUT_VERTICAL_PRESSED)) {
        Entities[e].vy += v * PLAYER_ACCEL;
        //Use whatever is the equivalent of abs() in GEL
        Entities[e].vy += v * FRICTION;
        Entities[e].vy = clamp(Entities[e].vy, -PLAYER_MAX_SPEED, PLAYER_MAX_SPEED);
    } else{
        
        if (abs(Entities[e].vy) > FRICTION) {
            Entities[e].vy += -sign(Entities[e].vy) * FRICTION;
        } else {
            Entities[e].vy = 0.0;
        }
    }
}

fn update_player(u16 e) {
    if (pad1_pressed & BTN_SELECT) {
        game_mode ^= 1;
        player_vx = 0.0;
        player_vy = 0.0;
    }

    if (player_state == STATE_DASHING && dash_frames > 0) {
        update_dash(e);
    } else {
        update_run(e);
    }

    if (game_mode == MODE_PLATFORMER) {
        update_platformer(e);
    } else {
        update_topdown(e);
    }

    move_x(e);
    move_y(e);
    u8 want_anim = PLAYER_MS_ANIM_IDLE;
    if (!bit_test(Entities[e].flags, MODE_FLAG_ON_GROUND)) {
        want_anim = PLAYER_MS_ANIM_AIR;
    } else if (Entities[e].state != STATE_IDLE) {
        want_anim = PLAYER_MS_ANIM_RUN;
    }
    set_anim(e, want_anim, Entities[e].clip != want_anim);
    update_footstep_sound(e);
}


