// ---------------- Entities ----------------
// Included by game.gel. One table holds every dynamic thing in the level. Entities are created
// from the Tiled object layer (spawn_level_objects) and each has a type, a position and a
// little state. What a type does is a branch in update_entities / draw_entities, so adding a
// type means adding an OBJ_* object in Tiled and one case here, not a new system.
//
// The player is not in this table yet; it still lives in player.gel.

#define ENT_SIZE        8       // pickup box, pixels
#define NO_METASPRITE   0xFFFF  // Entities[].animaddr when the entity holds no metasprite
// Pickups reuse the bullet tile (VRAM tile right after the metasprites' tiles, MS_TILE_END)
// and the OBJ palette right after the metasprites' palettes (MS_PAL_END).


struct_table Entities[10] {
    u8  type;    // OBJ_* constant
    u16 x;       // top-left, world pixels
    u16 y;
    u8  param;   // the Tiled "param" property
    u8  anim;    // bouncer: squash frame 0-3, 0 = idle
    f16 vx;      // velocity, pixels per step (the player mirrors player_vx / player_vy)
    f16 vy;
    i16 subx;    // sub-pixel remainders
    i16 suby;
    u16 animaddr;
    u8  state;     // player_state: STATE_*
    u8  flags;     // runtime mode flags
    u8  capabilities; // object-editor capability flags, separate from runtime mode state
    u8  dash;      // dash frames left
    u8  bounce;    // set by a bouncer so the short-hop cut doesn't clip the launch
    u8  djump;     // double jump used
    u8  charid;    // Character
    u8  abil;      // ABIL_* bits
    u8  air;       // air actions used since last touching the ground
    u8  wall;      // frames the wall can't be re-grabbed after a wall jump
    u8  clip;      // currently selected animation clip
    u8  step;      // step within the clip
    u8  timer;     // ticks spent on the current step
    u8  w;         // hitbox size in pixels (the player's box is HB_W x HB_H)
    u8  h;
    i8  dirx;      // direction the entity is facing, 0 = left, 1 = right, 2 = up, 3 = down
    i8  diry;      // vertical direction the entity is facing, 0 = up, 1 = down
}

enum EntityFlags {
    ENTITY_FLAG_MOVABLE = 0,
    ENTITY_FLAG_GHOST = 1,
    ENTITY_FLAG_GRAVITY = 3,
    ENTITY_FLAG_CONTACTABLE = 4
};

#define BOUNCE_W        20
#define BOUNCE_H        25
#define BOUNCE_SPEED    8.5     // touching the spring
#define BOUNCE_HIGH     11.0    // ground pounding onto it

u8 gem_sfx = 0;
persist u8 gems_collected = 0;

fn spawn_entity(u8 type, u16 ex, u16 ey, u8 param) {
    Entities.create();
    u16 slot = reg(X);
    if (slot != 0xFFFF) {
        Entities[slot].type  = type;
        Entities[slot].x     = ex;
        Entities[slot].y     = ey;
        Entities[slot].param = param;
        Entities[slot].anim  = 0;
        Entities[slot].vx    = 0.0;
        Entities[slot].vy    = 0.0;
        Entities[slot].subx  = 0;
        Entities[slot].suby  = 0;
        Entities[slot].state  = 0;
        Entities[slot].flags  = 0;
        Entities[slot].capabilities = object_capabilities(type);
        Entities[slot].dash   = 0;
        Entities[slot].bounce = 0;
        Entities[slot].djump  = 0;
        Entities[slot].charid = 0;
        Entities[slot].abil   = 0;
        Entities[slot].air    = 0;
        Entities[slot].wall   = 0;
        Entities[slot].clip   = 0;
        Entities[slot].step   = 0;
        Entities[slot].timer  = 0;
        Entities[slot].w      = ENT_SIZE;
        Entities[slot].h      = ENT_SIZE;
        Entities[slot].animaddr = NO_METASPRITE;
        // Everything type-specific comes from the object editor's data (objects.json).
        if (object_variant_has(type, param, OBJECT_VALUE_METASPRITE_ID)) {
            Entities[slot].animaddr = object_variant_value(type, param, OBJECT_VALUE_METASPRITE_ID);
        }
        object_apply_variant(slot, type, param);
    }
}

#define MAX_CONTACT_PAIRS 16

struct_table CollidingEntities[MAX_CONTACT_PAIRS] {
    u8 self;
    u8 other;
}

fn find_contact_pair(u8 e1, u8 e2) {
    CollidingEntities.for_each(p) {
        if (CollidingEntities[p].self == e1 && CollidingEntities[p].other == e2) {
            return p;
        }
    }
    return 0xFFFF;
}

fn add_contact_pair(u8 e1, u8 e2) {
    CollidingEntities.create();
    u16 slot = reg(X);
    if (slot != 0xFFFF) {
        CollidingEntities[slot].self = e1;
        CollidingEntities[slot].other = e2;
    }
}

fn entity_is_active(u8 entity) {
    Entities.for_each(active_entity) {
        if (active_entity == entity) { return 1; }
    }
    return 0;
}

// Directed Contact Dispatcher (Self -> Other, then Other -> Self)
fn dispatch_contact_event(u8 e1, u8 e2, u8 phase) {
    if (phase == 0) { // Contact Enter
        if (entity_is_active(e1) && bit_test(Entities[e1].capabilities, ENTITY_FLAG_CONTACTABLE)) {
            entity_on_contact(e1, e2);
        }
        if (entity_is_active(e2) && bit_test(Entities[e2].capabilities, ENTITY_FLAG_CONTACTABLE)) {
            entity_on_contact(e2, e1);
        }
    } else if (phase == 1) { // Contact Stay
        if (entity_is_active(e1) && bit_test(Entities[e1].capabilities, ENTITY_FLAG_CONTACTABLE)) {
            entity_on_stay(e1, e2);
        }
        if (entity_is_active(e2) && bit_test(Entities[e2].capabilities, ENTITY_FLAG_CONTACTABLE)) {
            entity_on_stay(e2, e1);
        }
    } else if (phase == 2) { // Contact Exit
        if (entity_is_active(e1) && bit_test(Entities[e1].capabilities, ENTITY_FLAG_CONTACTABLE)) {
            entity_on_exit(e1, e2);
        }
        if (entity_is_active(e2) && bit_test(Entities[e2].capabilities, ENTITY_FLAG_CONTACTABLE)) {
            entity_on_exit(e2, e1);
        }
    }
}

fn update_entity_contacts() {
    // 1. Process active collisions (Stay vs Exit)
    CollidingEntities.for_each(p) {
        u8 e1 = CollidingEntities[p].self;
        u8 e2 = CollidingEntities[p].other;

        if (!entity_is_active(e1) || !entity_is_active(e2)) {
            dispatch_contact_event(e1, e2, 2);
            CollidingEntities[p].free();
        } else if (entities_touch(e1, e2)) {
            dispatch_contact_event(e1, e2, 1);
        } else {
            dispatch_contact_event(e1, e2, 2);
            CollidingEntities[p].free();
        }
    }

    // 2. Scan pairs for new overlaps (Enter)
    Entities.for_each(e1) {
        if (bit_test(Entities[e1].capabilities, ENTITY_FLAG_CONTACTABLE)) {
            Entities.for_each(e2) {
                if (e1 < e2 && entity_is_active(e1) && bit_test(Entities[e2].capabilities, ENTITY_FLAG_CONTACTABLE)) {
                    if (entities_touch(e1, e2)) {
                        if (find_contact_pair(e1, e2) == 0xFFFF) {
                            add_contact_pair(e1, e2);
                            dispatch_contact_event(e1, e2, 0);
                        }
                    }
                }
            }
        }
    }
}

// The player owns slot 0: it is created first, so Entities.create() returns 0. Its type is
// OBJ_PLAYERSTART. player_x / player_y / player_vx ... in game.gel alias this slot's fields.
fn spawn_player_entity(u8 variant) {
    spawn_entity(OBJ_PLAYERSTART, 40, 186, variant);
    Entities[0].charid = CHAR_DASHER;
    Entities[0].abil   = ABIL_DASH;
    Entities[0].w      = HB_W;
    Entities[0].h      = HB_H;
    object_apply_variant(0, OBJ_PLAYERSTART, variant);
}

// Every level object other than PlayerStart (which only places the player) becomes an entity.
fn spawn_level_objects() {
    u8 i = 0;
    while (i < LEVEL_OBJECT_COUNT) {
        if (obj_type(i) != OBJ_PLAYERSTART) {
            spawn_entity(obj_type(i), obj_x(i), obj_y(i), obj_param(i));
        }
        i++;
    }
}
fn entities_touch(u16 e1, u16 e2) {
    if (Entities[e1].x >= Entities[e2].x + Entities[e2].w) { return 0; }
    if (Entities[e1].x + Entities[e1].w <= Entities[e2].x) { return 0; }
    if (Entities[e1].y >= Entities[e2].y + Entities[e2].h) { return 0; }
    if (Entities[e1].y + Entities[e1].h <= Entities[e2].y) { return 0; }
    return 1;
}

// Gravity, ground detection and collision for any non-player entity with MODE_FLAG_PHYSICS set.
// The player runs the same move_x / move_y through update_player.
fn entity_physics(u16 e) {
    if (hit_down(e)) {
        bit_set(Entities[e].flags, MODE_FLAG_ON_GROUND);
    } else {
        bit_clear(Entities[e].flags, MODE_FLAG_ON_GROUND);
    }
    Entities[e].vy += GRAVITY;
    if (Entities[e].vy > MAX_FALL) {
        Entities[e].vy = MAX_FALL;
    }
    move_x(e);
    move_y(e);
    update_anim(e);
}

// Runs once per logic step.
fn update_entities() {
    Entities.for_each(e) {
        if (e != PLAYER_ENT) {
            if (bit_test(Entities[e].flags, MODE_FLAG_PHYSICS)) {
                entity_physics(e);
            }
        }
    }
}

//This function needs to go. It needs to be a generic "draw metasprite"
fn draw_bouncer(i16 sx, i16 sy, u8 anim) {
    u8 bouncer_frame;
    bouncer_frame = 0;
    if (anim > 0) {
        bouncer_frame = 3;
        if (anim > 4) { bouncer_frame = 2; }
        if (anim > 8) { bouncer_frame = 1; }
    }
    std_draw_frame(
        MetaspriteHeader[SPRING_MS_ID].frame_table,
        bouncer_frame,
        sx,
        sy - SPRING_MS_OFF_Y,
        MetaspriteHeader[SPRING_MS_ID].attr,
        MetaspriteHeader[SPRING_MS_ID].tile_base
    );
}

fn ms_table_off(u16 table, u8 frame) {
    u16 ms_table_ptr;
    ms_table_ptr = table + (frame << 1); // Equivalent to frame + frame
    //Return lowbyte | highbyte
    //Basically-> | 0000 0000 | 0000 0000
    return peek8(ms_table_ptr) | (peek8(ms_table_ptr + 1) << 8);
}

#define SCREEN_W        266
#define SCREEN_H        224
#define DRAW_MARGIN     32      // entities this far off screen are still drawn (largest metasprite)

fn draw_entites(){
    u8 draw_attr = 0;
    i16 draw_x_pos = 0;
    u16 draw_animaddr = 0;
    u16 draw_off_x = 0;
    u16 draw_off_y = 0;
    u16 draw_anim_table = 0;
    u16 draw_frame_table = 0;
    i16 draw_frame_id = 0;
    i16 draw_entity_x = 0;
    i16 draw_entity_y = 0;
    i16 draw_off_mirror_x = 0;

    Entities.for_each(draw_e) {
        draw_entity_x = Entities[draw_e].x - cam_x;
        draw_entity_y = Entities[draw_e].y - cam_y;
        if (draw_entity_x >= -DRAW_MARGIN && draw_entity_x <= SCREEN_W && draw_entity_y >= -DRAW_MARGIN && draw_entity_y <= SCREEN_H) {
            
            update_anim(draw_e);
            draw_animaddr = Entities[draw_e].animaddr;
            if (draw_animaddr != NO_METASPRITE) {
            // Get current metasprite frame ID for this entity
            draw_frame_id = Entities[draw_e].anim;
            
            // Draw the metasprite to OAM buffer
            // (x, y, metasprite_frame_index, attributes/palette)
            draw_anim_table = MetaspriteHeader[draw_animaddr].anim_table;
            draw_frame_table = MetaspriteHeader[draw_animaddr].frame_table;
            draw_off_x = MetaspriteHeader[draw_animaddr].off_x;
            draw_off_y = MetaspriteHeader[draw_animaddr].off_y;
            draw_off_mirror_x = MetaspriteHeader[draw_animaddr].off_mirror_x;
            draw_frame_id = std_anim_frame(draw_anim_table, Entities[draw_e].clip, Entities[draw_e].step);
            draw_attr = MetaspriteHeader[draw_animaddr].attr | OAM_HFLIP;
            draw_x_pos = Entities[draw_e].x - ms_table_off(draw_off_mirror_x, draw_frame_id);
            if (bit_test(Entities[draw_e].flags, MODE_FLAG_DIRECTION)) {
                bit_clear(draw_attr, OAMB_HFLIP);
                draw_x_pos = Entities[draw_e].x - ms_table_off(draw_off_x, draw_frame_id);
            }
            std_draw_frame(
                draw_frame_table,
                draw_frame_id,
                draw_x_pos - cam_x,
                Entities[draw_e].y - ms_table_off(draw_off_y, draw_frame_id) - cam_y,
                draw_attr,
                MetaspriteHeader[draw_animaddr].tile_base
            );
            }
        }

    }
}

