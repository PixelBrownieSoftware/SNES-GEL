// ---------------- Entities ----------------
// Included by game.gel. One table holds every dynamic thing in the level. Entities are created
// from the Tiled object layer (spawn_level_objects) and each has a type, a position and a
// little state. What a type does is a branch in update_entities / draw_entities, so adding a
// type means adding an OBJ_* object in Tiled and one case here, not a new system.
//
// The player is not in this table yet; it still lives in player.gel.

#define ENT_SIZE        8       // pickup box, pixels
// Pickups reuse the bullet tile (VRAM tile right after the player's tiles, PLAYER_MS_TILE_COUNT)
// and OBJ palette 1 (attribute 0x32).


struct_table Entities[10] {
    u8  type;    // OBJ_* constant
    u16 x;       // top-left, world pixels
    u16 y;
    u8  param;   // the Tiled "param" property
    u8  anim;    // bouncer: squash frame 0-3, 0 = idle
    f16 vx;      // velocity, pixels per step (the player mirrors player_vx / player_vy)
    f16 vy;
    i16 subx;    // sub-pixel remainders
    i16 suby;
    u16 animaddr;
    u8  state;     // player_state: STATE_*
    u8  flags;     // mode and entity flags
    u8  dash;      // dash frames left
    u8  bounce;    // set by a bouncer so the short-hop cut doesn't clip the launch
    u8  djump;     // double jump used
    u8  charid;    // Character
    u8  abil;      // ABIL_* bits
    u8  air;       // air actions used since last touching the ground
    u8  wall;      // frames the wall can't be re-grabbed after a wall jump
    u8  clip;      // animation clip, chosen from physics state by update_anim
    u8  step;      // step within the clip
    u8  timer;     // ticks spent on the current step
    u8  w;         // hitbox size in pixels (the player's box is HB_W x HB_H)
    u8  h;
}

enum EntityFlags {
    ENTITY_FLAG_MOVABLE = 0,
    ENTITY_FLAG_GHOST = 1,
    ENTITY_FLAG_INPUT = 2,
    ENTITY_FLAG_GRAVITY = 3,
    ENTITY_FLAG_CONTACTABLE = 4
};

#define BOUNCE_W        20
#define BOUNCE_H        25
#define BOUNCE_SPEED    8.5     // touching the spring
#define BOUNCE_HIGH     11.0    // ground pounding onto it
#define BOUNCE_TILE     48      // VRAM tile index of the spring tiles (after player + bullet)
#define BOUNCE_ATTR     0x30    // priority 3; the palette slot (OBJ palette 2) is in the frame

u8 gem_sfx = 0;
persist u8 gems_collected = 0;

fn spawn_entity(u8 type, u16 ex, u16 ey, u8 param) {
    Entities.create();
    u16 slot = reg(X);
    if (slot != 0xFFFF) {
        Entities[slot].type  = type;
        Entities[slot].x     = ex;
        Entities[slot].y     = ey;
        Entities[slot].param = param;
        Entities[slot].anim  = 0;
        Entities[slot].vx    = 0.0;
        Entities[slot].vy    = 0.0;
        Entities[slot].subx  = 0;
        Entities[slot].suby  = 0;
        Entities[slot].state  = 0;
        Entities[slot].flags  = 0;
        Entities[slot].dash   = 0;
        Entities[slot].bounce = 0;
        Entities[slot].djump  = 0;
        Entities[slot].charid = 0;
        Entities[slot].abil   = 0;
        Entities[slot].air    = 0;
        Entities[slot].wall   = 0;
        Entities[slot].clip   = 0;
        Entities[slot].step   = 0;
        Entities[slot].timer  = 0;
        Entities[slot].w      = ENT_SIZE;
        Entities[slot].h      = ENT_SIZE;
        switch (type) {
            case OBJ_BOUNCER:
                Entities[slot].animaddr = 1;
                Entities[slot].w = BOUNCE_W;
                Entities[slot].h = BOUNCE_H;
                bit_set(Entities[slot].flags, ENTITY_FLAG_CONTACTABLE);
                break;
            case OBJ_GEM:
                bit_set(Entities[slot].flags, ENTITY_FLAG_CONTACTABLE);
                break;
            case OBJ_PLAYERSTART:
                Entities[slot].animaddr = 0;
                Entities[slot].w = HB_W;
                Entities[slot].h = HB_H;
                // Entities[slot].type = PLAYER;
                bit_set(Entities[slot].flags, ENTITY_FLAG_CONTACTABLE);
                break;
        }
    }
}

#define MAX_CONTACT_PAIRS 16

struct_table CollidingEntities[MAX_CONTACT_PAIRS] {
    u8 self;
    u8 other;
}

fn find_contact_pair(u8 e1, u8 e2) {
    CollidingEntities.for_each(p) {
        if (CollidingEntities[p].self == e1 && CollidingEntities[p].other == e2) {
            return p;
        }
    }
    return 0xFFFF;
}

fn add_contact_pair(u8 e1, u8 e2) {
    CollidingEntities.create();
    u16 slot = reg(X);
    if (slot != 0xFFFF) {
        CollidingEntities[slot].self = e1;
        CollidingEntities[slot].other = e2;
    }
}

// Directed Contact Dispatcher (Self -> Other, then Other -> Self)
fn dispatch_contact_event(u8 e1, u8 e2, u8 phase) {
    u8 e1_contact = bit_test(Entities[e1].flags, ENTITY_FLAG_CONTACTABLE);
    u8 e2_contact = bit_test(Entities[e2].flags, ENTITY_FLAG_CONTACTABLE);

    if (phase == 0) { // Contact Enter
        if (e1_contact) { 
            //entity_on_contact(e1, e2); 
        }
        if (e2_contact && Entities[e2].type != 0) { 
            // entity_on_contact(e2, e1); 
        }
    } else if (phase == 1) { // Contact Stay
        if (e1_contact) { 
            // entity_on_stay(e1, e2); 
        }
        if (e2_contact && Entities[e2].type != 0) { 
            // entity_on_stay(e2, e1); 
        }
    } else if (phase == 2) { // Contact Exit
        if (e1_contact) { 
            // entity_on_exit(e1, e2); 
        }
        if (e2_contact && Entities[e2].type != 0) { 
            // entity_on_exit(e2, e1); 
        }
    }
}

fn update_entity_contacts() {
    // 1. Process active collisions (Stay vs Exit)
    CollidingEntities.for_each(p) {
        u8 e1 = CollidingEntities[p].self;
        u8 e2 = CollidingEntities[p].other;

        if (Entities[e1].type == 0 || Entities[e2].type == 0) {
            dispatch_contact_event(e1, e2, 2);
            CollidingEntities[p].free();
        } else if (entities_touch(e1, e2)) {
            dispatch_contact_event(e1, e2, 1);
        } else {
            dispatch_contact_event(e1, e2, 2);
            CollidingEntities[p].free();
        }
    }

    // 2. Scan pairs for new overlaps (Enter)
    Entities.for_each(e1) {
        if (bit_test(Entities[e1].flags, ENTITY_FLAG_CONTACTABLE)) {
            Entities.for_each(e2) {
                if (e1 < e2 && bit_test(Entities[e2].flags, ENTITY_FLAG_CONTACTABLE)) {
                    if (entities_touch(e1, e2)) {
                        if (find_contact_pair(e1, e2) == 0xFFFF) {
                            add_contact_pair(e1, e2);
                            dispatch_contact_event(e1, e2, 0);
                        }
                    }
                }
            }
        }
    }
}

// The player owns slot 0: it is created first, so Entities.create() returns 0. Its type is
// OBJ_PLAYERSTART. player_x / player_y / player_vx ... in game.gel alias this slot's fields.
fn spawn_player_entity() {
    spawn_entity(OBJ_PLAYERSTART, 40, 186, 0);
    Entities[0].charid = CHAR_DASHER;
    Entities[0].abil   = ABIL_DASH;
    Entities[0].w      = HB_W;
    Entities[0].h      = HB_H;
}

// Every level object other than PlayerStart (which only places the player) becomes an entity.
fn spawn_level_objects() {
    u8 i = 0;
    while (i < LEVEL_OBJECT_COUNT) {
        if (obj_type(i) != OBJ_PLAYERSTART) {
            spawn_entity(obj_type(i), obj_x(i), obj_y(i), obj_param(i));
        }
        i++;
    }
}
fn entities_touch(u16 e1, u16 e2) {
    if (Entities[e1].x >= Entities[e2].x + Entities[e2].w) { return 0; }
    if (Entities[e1].x + Entities[e1].w <= Entities[e2].x) { return 0; }
    if (Entities[e1].y >= Entities[e2].y + Entities[e2].h) { return 0; }
    if (Entities[e1].y + Entities[e1].h <= Entities[e2].y) { return 0; }
    return 1;
}
//Todo: This function needs to redone into a generic touch function
// Box overlap between the player and entity e, using each one's own hitbox.
fn player_touches(u16 e) {
    if (Entities[e].x >= player_x + Entities[0].w) { return 0; }
    if (Entities[e].x + Entities[e].w <= player_x) { return 0; }
    if (Entities[e].y >= player_y + Entities[0].h) { return 0; }
    if (Entities[e].y + Entities[e].h <= player_y) { return 0; }
    return 1;
}

// A bouncer's point is the bottom-left of its sprite (w x h). Any falling player overlapping
// it is launched; a ground pound launches harder.
