#include "player.gel"
#include "entities.gel"

fn update_camera() {
    i16 cx = player_x - CAM_OFFSET_X;
    if (cx < 0) { cx = 0; }
    if (cx > LEVEL_MAX_CAM_X) { cx = LEVEL_MAX_CAM_X; }
    cam_x = cx;

    i16 cy = player_y - CAM_OFFSET_Y;
    if (cy < 0) { cy = 0; }
    if (cy > LEVEL_MAX_CAM_Y) { cy = LEVEL_MAX_CAM_Y; }
    cam_y = cy;
}

// Runs once per logic step, so animation speed is tied to the 60 Hz tick, not the frame rate.
// The clip is chosen from the entity's physics state alone (grounded, moving, airborne);
// update_anim never looks at what the clip contains.
fn update_anim(u16 e) {
    u8 want = PLAYER_MS_ANIM_IDLE;
    if (!bit_test(Entities[e].flags, MODE_FLAG_ON_GROUND)) {
        want = PLAYER_MS_ANIM_AIR;
    } else if (Entities[e].state != STATE_IDLE) {
        want = PLAYER_MS_ANIM_RUN;
    }
    if (want != Entities[e].clip) {
        Entities[e].clip = want;
        Entities[e].step = 0;
        Entities[e].timer = 0;
    }
    Entities[e].timer += 1;
    if (Entities[e].timer >= std_anim_ticks(PLAYER_MS_ANIMS, Entities[e].clip, Entities[e].step)) {
        Entities[e].timer = 0;
        Entities[e].step = std_anim_next(PLAYER_MS_ANIMS, Entities[e].clip, Entities[e].step);
    }
}

// Per-frame draw offset (16-bit) from a packer table: NORMAL_X, MIRROR_X or Y.
fn player_ms_off(u16 table, u8 frame) {
    u16 p = table + frame + frame;
    u16 lo = peek8(p);
    p++;
    u16 hi = peek8(p);
    return lo | (hi << 8);
}

fn render_player() {
    u8 frame = std_anim_frame(PLAYER_MS_ANIMS, Entities[0].clip, Entities[0].step);
    // The artwork faces left, so facing right (flag 0) is the flipped case.
    u8 attr = OAM_PRIO3 | OAM_HFLIP;
    i16 draw_x = player_x - player_ms_off(PLAYER_MS_MIRROR_X, frame);
    if (bit_test(mode_flags, MODE_FLAG_DIRECTION)) {
        bit_clear(attr, OAMB_HFLIP);
        draw_x = player_x - player_ms_off(PLAYER_MS_NORMAL_X, frame);
    }
    std_draw_frame(
        PLAYER_MS_FRAMES,
        frame,
        draw_x - cam_x,
        player_y - player_ms_off(PLAYER_MS_Y, frame) - cam_y,
        attr,
        0
    );
}

fn render_ability_hud() {
    std_print(1, 1, "ABILITY:");
    std_print(10, 1, "         ");
    switch (player_char) {
        case CHAR_JUMPER:  std_print(10, 1, "MULTIJUMP"); break;
        case CHAR_DASHER:  std_print(10, 1, "DASH");      break;
        case CHAR_GLIDER:  std_print(10, 1, "GLIDE");     break;
        case CHAR_POUNDER: std_print(10, 1, "POUND");     break;
        case CHAR_CLIMBER: std_print(10, 1, "CLIMB");     break;
    }
    std_print(1, 2, "X: CHANGE ABILITY");
}

// Debug readouts live in debug_overlay.lua (Mesen), not in the ROM.

// Logic runs at a fixed 60 Hz step driven by the NMI tick counter. If a frame takes
// too long, up to MAX_CATCHUP steps run in one go so game speed stays constant.
#define MAX_CATCHUP 4

fn game_tick() {
    u8 steps = std_frames_elapsed(MAX_CATCHUP);

    // DMA only if enough VBlank remains: OAM needs ~5 lines, the map rows ~7, the 2KB text
    // map ~13, and VBlank ends at line 262. Anything skipped is simply uploaded next frame.
    u16 v = std_vcount();
    if (v >= 225) {
        if (v <= 250) {
            std_oam_flush_dma();
            if (v <= 232) {
                level_stream();
            }
            // The map is a 32-row ring (256 px), so the vertical scroll only needs the low byte.
            std_set_scroll(cam_x, cam_y & 0xFF);
        }
        if (v <= 235) {
            std_text_flush();
        }
    }

    std_oam_begin();
    while (steps > 0) {
        std_input_update();
        update_player();
        update_camera();
        update_anim(PLAYER_ENT);
        update_entities();
        // update_bullets();
        steps -= 1;
    }
    std_sound_update();
    // draw_bullets();
    render_player();
    draw_entities();
    render_ability_hud();
    std_oam_end();
}

fn init_game() {
    // 1. Initialize S-CPU, Native Mode, and Force Blanking
    std_snes_init();
    std_oam_clear();
    std_sound_init();
    if (SFX_ECHO) {
        std_music_load(MOD_ECHO);
        std_music_play(0);
    }
    player_jump_sfx = std_sfx_load(SFX_JUMP);
    player_dash_sfx = std_sfx_load(SFX_DASH);
    gem_sfx = std_sfx_load(SFX_GEM_COLLECT);
    player_land_sfx = std_sfx_load(SFX_LAND);
    player_footstep_sfx1 = std_sfx_load(SFX_G_FOOTSTEP1);
    player_footstep_sfx2 = std_sfx_load(SFX_G_FOOTSTEP2);
    player_footstep_sfx3 = std_sfx_load(SFX_G_FOOTSTEP3);
    player_footstep_sfx4 = std_sfx_load(SFX_G_FOOTSTEP4);
    player_footstep_sfx5 = std_sfx_load(SFX_G_FOOTSTEP5);

    // 2. Upload palettes and tile graphics while the screen is blanked.
    //    OBJ palettes occupy CGRAM 128-255, i.e. palette indices 8-15.
    std_load_palette(8, SPRITE_PALETTE_ADDR, 16);
    std_load_vram(0x0000, SPRITE_TILES_ADDR, PLAYER_MS_BYTE_LEN);
    // Bullet tile sits right after the player's tiles, using OBJ palette 1 (CGRAM 144).
    std_load_palette(9, BULLET_PALETTE, 16);
    std_load_vram(PLAYER_MS_TILE_COUNT * 16, BULLET_TILES, BULLET_BYTE_LEN);
    // Bouncer sheet: OBJ palette 2 (CGRAM 160), tiles from index 48.
    std_load_palette(10, SPRING_MS_PAL2, 16);
    std_load_vram(BOUNCE_TILE * 16, SPRING_MS_TILES, SPRING_MS_BYTE_LEN);
    std_text_init(FONT_PALETTE, FONT_TILES, FONT_BYTE_LEN);
    std_level_setup(TERRAIN_PALETTE, TERRAIN_TILES, TERRAIN_BYTE_LEN, LEVEL_SC_SIZE);

    // Sky-blue backdrop (colour 0 shows wherever no layer draws).
    CGADD  = 0;
    CGDATA = 0x8A;
    CGDATA = 0x7E;

    // 3. Layers: OBJ + BG1 (text) + BG2 (level)
    OBJSEL = 0x00;
    TM     = 0x13;

    // 4. Spawn at the level's PlayerStart object (skipped when a hot reload restored the table),
    //    then fill the level's VRAM window around the camera while the screen is still blanked.
    if (Entities[0].type == 0) {
        spawn_player_entity();
        u8 start = obj_find(OBJ_PLAYERSTART);
        if (start != 255) {
            player_x = obj_x(start);
            player_y = obj_y(start);
        }
        spawn_level_objects();
    }
    update_camera();
    level_stream_init();

    // 5. Enable Controller Auto-Joypad Read, then TURN SCREEN ON
    NMITIMEN = 0x81;
    INIDISP = 0x0F;

    // 7. Main Execution Loop
    u8 running = 1;
    while (running) {
        game_tick();
    }
}
