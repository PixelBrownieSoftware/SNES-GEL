// ---------------- Tuning ----------------
#define PLAYER_ACCEL        0.15
#define FRICTION            0.25
#define PLAYER_MAX_SPEED    1.5
#define DASH_SPEED          5.0
#define DASH_DURATION       16
#define DASH_EXIT_SPEED     3.0

#define GRAVITY             0.3
#define MAX_FALL            6.0
#define JUMP_SPEED          5.5
#define JUMP_CUT_SPEED      2.0
#define BULLET_SPEED        4

// player_x / player_y are the top-left of the collision box, in world pixels.
#define HB_W                18
#define HB_H                46
// Camera keeps the player's body centred on screen.
#define CAM_OFFSET_X        119
#define CAM_OFFSET_Y        96

#define SPRITE_TILES_ADDR   PLAYER_MS_TILES

// The MetaspriteHeader table (pinned at $1000, just after TextMap's $0800-$0FFF) and
// ms_load_all() are generated from the metasprite editor's projects: see metasprites.gel.

enum PlayerState {
    STATE_IDLE,
    STATE_MOVING,
    STATE_DASHING
};

enum PlayerModeFlags {
    MODE_FLAG_ON_GROUND = 0,
    MODE_FLAG_POUNDING  = 1,
    MODE_FLAG_DIRECTION = 2,
    MODE_FLAG_CLIMBING  = 3,
    MODE_FLAG_PHYSICS   = 4     // non-player entity that runs entity_physics()
};

// SELECT switches between the two movement styles at runtime.
enum GameMode {
    MODE_PLATFORMER,
    MODE_TOPDOWN
};

// The player is slot 0 of the Entities table (see entities.gel). These names alias its fields,
// so player.gel and the collision code read and write the entity directly.
#define PLAYER_ENT   0//9 if you want to be the spring
#define player_x     Entities[0].x
#define player_y     Entities[0].y
#define player_subx  Entities[0].subx
#define player_suby  Entities[0].suby
#define player_vx    Entities[0].vx
#define player_vy    Entities[0].vy
// Set by a bouncer so the short-hop cut doesn't clip the launch; cleared once falling.
#define bouncing      Entities[0].bounce
#define player_state  Entities[0].state
// mode_flags bit 0: on_ground; 1: pounding; 2: direction (0 = right, 1 = left); 3: climbing.
#define mode_flags    Entities[0].flags
#define dash_frames   Entities[0].dash
#define dash_frames   Entities[0].dash
f16 player_air_res = 1.0;
persist u8  game_mode    = MODE_PLATFORMER;
persist u16 cam_x        = 0;
persist u16 cam_y        = 0;
#define double_jump   Entities[0].djump
u8 player_jump_sfx = 0;
u8 player_land_sfx = 0;
u8 player_dash_sfx = 0;
u8 player_footstep_sfx1 = 0;
u8 player_footstep_sfx2 = 0;
u8 player_footstep_sfx3 = 0;
u8 player_footstep_sfx4 = 0;
u8 player_footstep_sfx5 = 0;
u8 footstep_timer = 0;
u8 footstep_index = 0;

// ---------------- Level map streaming ----------------
#include "level-data.gel"
// The BG tilemap in VRAM is a ring of 32 rows: world row r lives in VRAM row r & 31, so the
// hardware wraps the scroll for us. level_top is the first world row currently in the ring.
// Moving the window down by one row replaces the row leaving the top with the one entering at
// the bottom (same VRAM row), and vice versa when moving up.
u16 level_top = 0;
#define STREAM_ROWS_PER_FRAME 5

// Copies one 64-byte map row (per page) from ROM into its VRAM row.
fn level_load_row(u16 r) {
    u16 page = 0;
    while (page < LEVEL_PAGES) {
        std_load_vram_far(0x4000 + (page << 10) + ((r & 31) << 5), LEVEL_BANK,
                          LEVEL_MAP + page * LEVEL_PAGE_BYTES + (r << 6), 64);
        page++;
    }
}

// The window start that keeps the camera's rows (plus a little slack) inside the ring.
fn level_want_top() {
    u16 want = cam_y >> 3;
    if (want > 0) { want -= 1; }
    if (want > LEVEL_MAX_TOP) { want = LEVEL_MAX_TOP; }
    return want;
}

// Fills the whole ring. Call with the screen blanked.
fn level_stream_init() {
    level_top = level_want_top();
    u16 r = 0;
    while (r < 32) {
        level_load_row(level_top + r);
        r++;
    }
}

// Call during VBlank, before setting the scroll registers.
fn level_stream() {
    u16 want = level_want_top();
    u8 budget = STREAM_ROWS_PER_FRAME;
    while (level_top != want) {
        if (budget == 0) { return 0; }
        budget--;
        if (level_top < want) {
            level_load_row(level_top + 32);
            level_top++;
        } else {
            level_top--;
            level_load_row(level_top);
        }
    }
}

// ---------------- Level collision ----------------
#define TILE_SIZE_PX                 8
#define TILE_COORD_MASK              7
#define TILE_COORD_SHIFT             3
#define TILE_LAST_PIXEL              7
#define TILE_ROW_MASK                0xFFF8
#define COLLISION_EMPTY              0
#define COLLISION_SOLID              1
// Empty tile with a slope directly above or below it (set by level_pack.py): the only empty
// tiles where solid_at must look at the neighbouring rows.
#define COLLISION_NEAR_SLOPE         0x40
#define COLLISION_SLOPE_FLAG         0x80
// A slope cell is COLLISION_SLOPE_FLAG | index into the level's slope table (LEVEL_SLOPES): one
// byte per pixel column (SLOPE_PROFILE_SHIFT gives 8 per profile), the surface height relative
// to the tile top plus SLOPE_BIAS_PX so it is never negative. See level_pack.py.
#define SLOPE_INDEX_MASK             0x7F
#define SLOPE_PROFILE_SHIFT          3
// slope_surface_at_x returns the surface height plus this.
#define SLOPE_BIAS_PX                8
#define SLOPE_STEP_UP_PX             8
#define SLOPE_SNAP_DOWN_PX           4

// `code` is the collision byte already read at (wx, wy), so callers that have it avoid a second read.
fn solid_with_code(u16 wx, u16 wy, u8 code) {
    if (code == COLLISION_EMPTY) { return 0; }
    if (code != COLLISION_NEAR_SLOPE && !(code & COLLISION_SLOPE_FLAG)) { return 1; }

    u8 current_code = code;
    u16 row = wy & TILE_ROW_MASK;
    u16 y_in_tile = wy & TILE_COORD_MASK;
    u16 surface;
    if (row >= TILE_SIZE_PX) {
        code = collision_code_at(wx, row - TILE_SIZE_PX);
        if (code & COLLISION_SLOPE_FLAG) {
            surface = slope_surface_at_x(code, wx);
            if (y_in_tile + TILE_SIZE_PX + SLOPE_BIAS_PX >= surface) { return 1; }
        }
    }
    if (current_code & COLLISION_SLOPE_FLAG) {
        surface = slope_surface_at_x(current_code, wx);
        if (y_in_tile + SLOPE_BIAS_PX >= surface) { return 1; }
    }
    if (row + TILE_SIZE_PX < LEVEL_HEIGHT_PX) {
        code = collision_code_at(wx, row + TILE_SIZE_PX);
        if (code & COLLISION_SLOPE_FLAG) {
            surface = slope_surface_at_x(code, wx);
            if (surface <= TILE_LAST_PIXEL && y_in_tile >= surface) { return 1; }
        }
    }
    return 0;
}

fn solid_at(u16 wx, u16 wy) {
    return solid_with_code(wx, wy, collision_code_at(wx, wy));
}

// Any solid tile along a vertical strip at wx (wy_bot is inclusive). Scans from the bottom up:
// the feet are where slopes and ground are, so a blocked probe usually exits on the first sample.
fn solid_v(u16 wx, u16 wy_top, u16 wy_bot) {
    u16 y = wy_bot;
    u8 scanning = 1;
    while (scanning) {
        u8 code = collision_code_at(wx, y);
        if (code != COLLISION_EMPTY) {
            if (solid_with_code(wx, y, code)) { return 1; }
        }
        u16 tile_top = y & TILE_ROW_MASK;
        if (tile_top <= wy_top) {
            scanning = 0;
        } else {
            y = tile_top - 1;
        }
    }
    return 0;
}

// Any solid tile along a horizontal strip at wy (wx_right is inclusive).
fn solid_h(u16 wy, u16 wx_left, u16 wx_right) {
    u16 x = wx_left;
    while (x <= wx_right) {
        u16 tile_right = x | TILE_COORD_MASK;
        if (tile_right > wx_right) { tile_right = wx_right; }
        // Plain air (the common case) costs a single collision read.
        u8 code = collision_code_at(x, wy);
        if (code != COLLISION_EMPTY) {
            if (solid_with_code(x, wy, code)) { return 1; }
            // A slope is monotonic within a tile, so checking both ends catches its floor efficiently.
            if (tile_right != x) {
                if (solid_at(tile_right, wy)) { return 1; }
            }
        }
        x = tile_right + 1;
    }
    return 0;
}

// Collision probes and movement work on any entity slot, so every entity shares the same physics.
fn hit_right(u16 e) { return solid_v(Entities[e].x + Entities[e].w, Entities[e].y, Entities[e].y + Entities[e].h - 1); }
fn hit_left(u16 e)  { return solid_v(Entities[e].x - 1,             Entities[e].y, Entities[e].y + Entities[e].h - 1); }
fn hit_down(u16 e)  { return solid_h(Entities[e].y + Entities[e].h, Entities[e].x, Entities[e].x + Entities[e].w - 1); }
fn hit_up(u16 e)    { return solid_h(Entities[e].y - 1,             Entities[e].x, Entities[e].x + Entities[e].w - 1); }

// Walking into a slope: lift the entity (up to SLOPE_STEP_UP_PX) to the height where the
// column it is walking into is clear. Returns 1 and keeps the new height if that worked.
fn step_up(u16 e, u8 move_right) {
    if (!bit_test(Entities[e].flags, MODE_FLAG_ON_GROUND)) { return 0; }

    u16 side_x;
    if (move_right) { side_x = Entities[e].x + Entities[e].w; }
    else { side_x = Entities[e].x - 1; }
    u8 ahead = collision_code_at(side_x, Entities[e].y + Entities[e].h - 1);
    if (!(ahead & COLLISION_SLOPE_FLAG)) { return 0; }

    // Measure the step on the one column being walked into, then verify the lifted hitbox once
    // instead of re-testing it for every pixel. The slope table gives the lift directly; the
    // probe loop below is the fallback when that guess doesn't land on the surface.
    u16 feet = Entities[e].y + Entities[e].h - 1;
    u8 lift = 1;
    u16 base = (feet & TILE_COORD_MASK) + 1 + SLOPE_BIAS_PX;
    u16 surface = slope_surface_at_x(ahead, side_x);
    if (base > surface) {
        u16 guess = base - surface;
        if (guess > 1) {
            if (guess <= SLOPE_STEP_UP_PX) {
                if (solid_at(side_x, feet - guess + 1)) { lift = guess; }
            }
        }
    }
    while (lift <= SLOPE_STEP_UP_PX) {
        if (!solid_at(side_x, feet - lift)) {
            u16 old_y = Entities[e].y;
            Entities[e].y = old_y - lift;
            u8 blocked = solid_h(Entities[e].y, Entities[e].x, Entities[e].x + Entities[e].w - 1);
            if (!blocked) {
                if (move_right) { blocked = hit_right(e); }
                else { blocked = hit_left(e); }
            }
            if (!blocked) { return 1; }
            Entities[e].y = old_y;
            return 0;
        }
        lift++;
    }
    return 0;
}

// Walking down a slope: drop back onto the ground (up to SLOPE_SNAP_DOWN_PX) instead of
// stepping off it for a frame.
fn step_down(u16 e) {
    if (!bit_test(Entities[e].flags, MODE_FLAG_ON_GROUND)) { return 0; }
    if (Entities[e].vy < 0.0) { return 0; }

    u16 old_y = Entities[e].y;
    u8 drop = 0;
    while (drop < SLOPE_SNAP_DOWN_PX) {
        if (hit_down(e)) {
            if (drop > 0) {
                Entities[e].vy = 0.0;
                Entities[e].suby = 0;
            }
            return 1;
        }
        Entities[e].y++;
        drop++;
    }
    if (hit_down(e)) {
        Entities[e].vy = 0.0;
        Entities[e].suby = 0;
        return 1;
    }
    Entities[e].y = old_y;
    return 0;
}

// ---------------- Movement (1 pixel at a time so nothing tunnels) ----------------
fn move_x(u16 e) {
    i16 t = Entities[e].subx + Entities[e].vx;
    i16 dx = t >> 8;
    u8 moved = 0;
    Entities[e].subx = t & 0xFF;
    while (dx > 0) {
        if (hit_right(e)) {
            if (step_up(e, 1)) {
                Entities[e].x++;
                moved = 1;
                dx--;
            } else {
                Entities[e].vx = 0.0;
                Entities[e].subx = 0;
                Entities[e].dash = 0;
                dx = 0;
            }
        } else {
            Entities[e].x++;
            moved = 1;
            dx--;
        
            Entities[e].dirx = 1;
        }
    }
    while (dx < 0) {
        if (hit_left(e)) {
            if (step_up(e, 0)) {
                Entities[e].x--;
                moved = 1;
                dx++;
            } else {
                Entities[e].vx = 0.0;
                Entities[e].subx = 0;
                Entities[e].dash = 0;
                dx = 0;
            }
        } else {
            Entities[e].x--;
            moved = 1;
            dx++;
        
            Entities[e].dirx = -1;
        }
    }
    if (moved) { step_down(e); }
}

fn move_y(u16 e) {
    i16 t = Entities[e].suby + Entities[e].vy;
    i16 dy = t >> 8;
    Entities[e].suby = t & 0xFF;
    while (dy > 0) {
        if (hit_down(e)) {
            Entities[e].vy = 0.0;
            Entities[e].suby = 0;
            dy = 0;
        } else {
            Entities[e].y++;
            dy--;
        }
    }
    while (dy < 0) {
        if (hit_up(e)) {
            Entities[e].vy = 0.0;
            Entities[e].suby = 0;
            dy = 0;
        } else {
            Entities[e].y--;
            dy++;
        }
    }
}

#include "player.gel"
#include "entities.gel"
#include "contact.gel"
i16 cam_calc_x = 0;
i16 cam_calc_y = 0;

fn update_camera(u16 e) {
    cam_calc_x = Entities[e].x - CAM_OFFSET_X;
    if (cam_calc_x < 0) { cam_calc_x = 0; }
    if (cam_calc_x > LEVEL_MAX_CAM_X) { cam_calc_x = LEVEL_MAX_CAM_X; }
    cam_x = cam_calc_x;

    cam_calc_y = Entities[e].y - CAM_OFFSET_Y;
    if (cam_calc_y < 0) { cam_calc_y = 0; }
    if (cam_calc_y > LEVEL_MAX_CAM_Y) { cam_calc_y = LEVEL_MAX_CAM_Y; }
    cam_y = cam_calc_y;
}

// Advances the selected clip once per logic step.
fn update_anim(u16 e) {
    u16 anim_ind = Entities[e].animaddr;
    u16 anim_table = MetaspriteHeader[anim_ind].anim_table;

    Entities[e].timer += 1;
    if (Entities[e].timer >= std_anim_ticks(anim_table, Entities[e].clip, Entities[e].step)) {
        Entities[e].timer = 0;
        Entities[e].step = std_anim_next(anim_table, Entities[e].clip, Entities[e].step);
    }

}

// The HUD text only changes with the ability, so it is redrawn then (255 forces the first draw).
#define HUD_UNDRAWN 255
u8 hud_char = HUD_UNDRAWN;

fn render_ability_hud() {
    if (player_char == hud_char) { return 0; }
    hud_char = player_char;
    std_print(1, 1, "ABILITY:");
    std_print(10, 1, "         ");
    switch (player_char) {
        case CHAR_JUMPER:  std_print(10, 1, "MULTIJUMP"); break;
        case CHAR_DASHER:  std_print(10, 1, "DASH");      break;
        case CHAR_GLIDER:  std_print(10, 1, "GLIDE");     break;
        case CHAR_POUNDER: std_print(10, 1, "POUND");     break;
        case CHAR_CLIMBER: std_print(10, 1, "CLIMB");     break;
    }
    std_print(1, 2, "X: CHANGE ABILITY");
}

// Debug readouts live in debug_overlay.lua (Mesen), not in the ROM.

// Logic runs at a fixed 60 Hz step driven by the NMI tick counter. If a frame takes
// too long, up to MAX_CATCHUP steps run in one go so game speed stays constant.
#define MAX_CATCHUP 4

fn game_tick() {
    u8 steps = std_frames_elapsed(MAX_CATCHUP);

    // DMA only if enough VBlank remains: OAM needs ~5 lines, the map rows ~7, the 2KB text
    // map ~13, and VBlank ends at line 262. Anything skipped is simply uploaded next frame.
    u16 v = std_vcount();
    if (v >= 225) {
        if (v <= 250) {
            std_oam_flush_dma();
            if (v <= 232) {
                level_stream();
            }
            // The map is a 32-row ring (256 px), so the vertical scroll only needs the low byte.
            std_set_scroll(cam_x, cam_y & 0xFF);
        }
        if (v <= 235) {
            std_text_flush();
        }
    }

    std_oam_begin();
    while (steps > 0) {
        std_input_update();
        poll_input();
        update_player(PLAYER_ENT);
        update_camera(PLAYER_ENT);
        update_entities();
        update_entity_contacts();
        steps -= 1;
    
    }
    std_sound_update();
    // draw_bullets();
    // render_player();
    // draw_entities();
    draw_entites();
    render_ability_hud();
    std_oam_end();
}

fn init_game() {
    // 1. Initialize S-CPU, Native Mode, and Force Blanking
    std_snes_init();
    std_oam_clear();
    std_sound_init();
    if (SFX_ECHO) {
        std_music_load(MOD_ECHO);
        std_music_play(0);
    }
    player_jump_sfx = std_sfx_load(SFX_JUMP);
    player_dash_sfx = std_sfx_load(SFX_DASH);
    gem_sfx = std_sfx_load(SFX_GEM_COLLECT);
    player_land_sfx = std_sfx_load(SFX_LAND);
    player_footstep_sfx1 = std_sfx_load(SFX_G_FOOTSTEP1);
    player_footstep_sfx2 = std_sfx_load(SFX_G_FOOTSTEP2);
    player_footstep_sfx3 = std_sfx_load(SFX_G_FOOTSTEP3);
    player_footstep_sfx4 = std_sfx_load(SFX_G_FOOTSTEP4);
    player_footstep_sfx5 = std_sfx_load(SFX_G_FOOTSTEP5);

    // 2. Upload palettes and tile graphics while the screen is blanked.
    //    OBJ palettes occupy CGRAM 128-255, i.e. palette indices 8-15.
    //    ms_load_all() (generated in metasprites.gel) loads every metasprite project's
    //    palettes and tiles and fills the MetaspriteHeader table; everything else follows it.
    ms_load_all();
    // Bullet tile sits right after the metasprites' tiles, in the next free OBJ palette.
    std_load_palette(8 + MS_PAL_END, BULLET_PALETTE, 16);
    std_load_vram(MS_TILE_END * 16, BULLET_TILES, BULLET_BYTE_LEN);
    std_text_init(FONT_PALETTE, FONT_TILES, FONT_BYTE_LEN);
    std_level_setup(TERRAIN_PALETTE, TERRAIN_TILES, TERRAIN_BYTE_LEN, LEVEL_SC_SIZE);

    // Sky-blue backdrop (colour 0 shows wherever no layer draws).
    CGADD  = 0;
    CGDATA = 0x8A;
    CGDATA = 0x7E;

    // 3. Layers: OBJ + BG1 (text) + BG2 (level)
    OBJSEL = 0x00;
    TM     = 0x13;

    // 4. Spawn at the level's PlayerStart object (skipped when a hot reload restored the table),
    //    then fill the level's VRAM window around the camera while the screen is still blanked.
    if (Entities[0].type == 0) {
        u8 start = obj_find(OBJ_PLAYERSTART);
        u8 player_variant = 0;
        if (start != 255) { player_variant = obj_param(start); }
        spawn_player_entity(player_variant);
        if (start != 255) {
            player_x = obj_x(start);
            player_y = obj_y(start);
        }
        spawn_level_objects();
    }
    update_camera(PLAYER_ENT);
    level_stream_init();

    // 5. Enable Controller Auto-Joypad Read, then TURN SCREEN ON
    NMITIMEN = 0x81;
    INIDISP = 0x0F;

    // 7. Main Execution Loop
    u8 running = 1;
    while (running) {
        game_tick();
    }
}

fn set_anim(u16 e, u16 want_anim, u8 is_reset) {
    if (is_reset == 1) {
    
        Entities[e].timer = 0;
        Entities[e].step = 0;
        
    }
    Entities[e].clip = want_anim;
}
