#include "snes.gel"
#include "assets.gel"
#include "sound.gel"

// ---------------- Tuning ----------------
#define PLAYER_ACCEL        0.15
#define FRICTION            0.25
#define PLAYER_MAX_SPEED    1.5
#define DASH_SPEED          8.0
#define DASH_DURATION       8
#define DASH_EXIT_SPEED     3.0

#define GRAVITY             0.3
#define MAX_FALL            6.0
#define JUMP_SPEED          5.5
#define JUMP_CUT_SPEED      2.0
#define BULLET_SPEED        4

// player_x / player_y are the top-left of the collision box, in world pixels.
#define HB_W                18
#define HB_H                46
// Camera keeps the player's body centred on screen.
#define CAM_OFFSET_X        119
#define CAM_OFFSET_Y        96

#define SPRITE_PALETTE_ADDR PLAYER_MS_PAL0
#define SPRITE_TILES_ADDR   PLAYER_MS_TILES

enum PlayerState {
    STATE_IDLE,
    STATE_MOVING,
    STATE_DASHING
};

enum PlayerModeFlags {
    MODE_FLAG_ON_GROUND = 0,
    MODE_FLAG_POUNDING  = 1,
    MODE_FLAG_DIRECTION = 2,
    MODE_FLAG_CLIMBING  = 3,
    MODE_FLAG_PHYSICS   = 4     // non-player entity that runs entity_physics()
};

// SELECT switches between the two movement styles at runtime.
enum GameMode {
    MODE_PLATFORMER,
    MODE_TOPDOWN
};

// The player is slot 0 of the Entities table (see entities.gel). These names alias its fields,
// so player.gel and the collision code read and write the entity directly.
#define PLAYER_ENT   0
#define player_x     Entities[0].x
#define player_y     Entities[0].y
#define player_subx  Entities[0].subx
#define player_suby  Entities[0].suby
#define player_vx    Entities[0].vx
#define player_vy    Entities[0].vy
// Set by a bouncer so the short-hop cut doesn't clip the launch; cleared once falling.
#define bouncing      Entities[0].bounce
#define player_state  Entities[0].state
// mode_flags bit 0: on_ground; 1: pounding; 2: direction (0 = right, 1 = left); 3: climbing.
#define mode_flags    Entities[0].flags
#define dash_frames   Entities[0].dash
f16 player_air_res = 1.0;
persist u8  game_mode    = MODE_PLATFORMER;
persist u16 cam_x        = 0;
persist u16 cam_y        = 0;
#define double_jump   Entities[0].djump
u8 player_jump_sfx = 0;
u8 player_land_sfx = 0;
u8 player_dash_sfx = 0;
u8 player_footstep_sfx1 = 0;
u8 player_footstep_sfx2 = 0;
u8 player_footstep_sfx3 = 0;
u8 player_footstep_sfx4 = 0;
u8 player_footstep_sfx5 = 0;
u8 footstep_timer = 0;
u8 footstep_index = 0;

// ---------------- Level objects (from the Tiled object layer) ----------------
// ---------------- Level data (own ROM bank) and map streaming ----------------
// LEVEL_OBJECTS: a count byte, then 6 bytes per object: type, x (16-bit), y (16-bit), param.
// Types are the OBJ_* constants generated from each object's Tiled Class. x/y is the top-left.
// Level data lives in bank LEVEL_BANK; the LEVEL_* names are offsets inside it.
#define OBJ_ENTRY_SIZE 6

fn obj_addr(u8 i) {
    return LEVEL_OBJECTS + 1 + (i << 2) + (i << 1);
}

fn obj_type(u8 i) { return peek8l(LEVEL_BANK, obj_addr(i)); }
fn obj_param(u8 i) { return peek8l(LEVEL_BANK, obj_addr(i) + 5); }

fn obj_x(u8 i) {
    u16 p = obj_addr(i) + 1;
    u16 lo = peek8l(LEVEL_BANK, p);
    p++;
    u16 hi = peek8l(LEVEL_BANK, p);
    return lo | (hi << 8);
}

fn obj_y(u8 i) {
    u16 p = obj_addr(i) + 3;
    u16 lo = peek8l(LEVEL_BANK, p);
    p++;
    u16 hi = peek8l(LEVEL_BANK, p);
    return lo | (hi << 8);
}

// The BG tilemap in VRAM is a ring of 32 rows: world row r lives in VRAM row r & 31, so the
// hardware wraps the scroll for us. level_top is the first world row currently in the ring.
// Moving the window down by one row replaces the row leaving the top with the one entering at
// the bottom (same VRAM row), and vice versa when moving up.
u16 level_top = 0;
#define STREAM_ROWS_PER_FRAME 5

// Copies one 64-byte map row (per page) from ROM into its VRAM row.
fn level_load_row(u16 r) {
    u16 page = 0;
    while (page < LEVEL_PAGES) {
        std_load_vram_far(0x4000 + (page << 10) + ((r & 31) << 5), LEVEL_BANK,
                          LEVEL_MAP + page * LEVEL_PAGE_BYTES + (r << 6), 64);
        page++;
    }
}

// The window start that keeps the camera's rows (plus a little slack) inside the ring.
fn level_want_top() {
    u16 want = cam_y >> 3;
    if (want > 0) { want -= 1; }
    if (want > LEVEL_MAX_TOP) { want = LEVEL_MAX_TOP; }
    return want;
}

// Fills the whole ring. Call with the screen blanked.
fn level_stream_init() {
    level_top = level_want_top();
    u16 r = 0;
    while (r < 32) {
        level_load_row(level_top + r);
        r++;
    }
}

// Call during VBlank, before setting the scroll registers.
fn level_stream() {
    u16 want = level_want_top();
    u8 budget = STREAM_ROWS_PER_FRAME;
    while (level_top != want) {
        if (budget == 0) { return 0; }
        budget--;
        if (level_top < want) {
            level_load_row(level_top + 32);
            level_top++;
        } else {
            level_top--;
            level_load_row(level_top);
        }
    }
}

// Index of the first object of this type, or 255 if the level has none.
fn obj_find(u8 type) {
    u8 i = 0;
    while (i < LEVEL_OBJECT_COUNT) {
        if (obj_type(i) == type) { return i; }
        i++;
    }
    return 255;
}

// ---------------- Level collision ----------------
fn solid_at(u16 wx, u16 wy) {
    if (wx >= LEVEL_WIDTH_PX) { return 1; }
    if (wy >= LEVEL_HEIGHT_PX) { return 1; }
    return peek8l(LEVEL_BANK, LEVEL_COLL + (((wy >> 3) << LEVEL_ROW_SHIFT) + (wx >> 3)));
}

// Any solid tile along a vertical strip at wx (wy_bot is inclusive).
fn solid_v(u16 wx, u16 wy_top, u16 wy_bot) {
    u16 y = wy_top;
    while (y < wy_bot) {
        if (solid_at(wx, y)) { return 1; }
        y += 8;
    }
    return solid_at(wx, wy_bot);
}

// Any solid tile along a horizontal strip at wy (wx_right is inclusive).
fn solid_h(u16 wy, u16 wx_left, u16 wx_right) {
    u16 x = wx_left;
    while (x < wx_right) {
        if (solid_at(x, wy)) { return 1; }
        x += 8;
    }
    return solid_at(wx_right, wy);
}

// Collision probes and movement work on any entity slot, so every entity shares the same physics.
fn hit_right(u16 e) { return solid_v(Entities[e].x + Entities[e].w, Entities[e].y, Entities[e].y + Entities[e].h - 1); }
fn hit_left(u16 e)  { return solid_v(Entities[e].x - 1,             Entities[e].y, Entities[e].y + Entities[e].h - 1); }
fn hit_down(u16 e)  { return solid_h(Entities[e].y + Entities[e].h, Entities[e].x, Entities[e].x + Entities[e].w - 1); }
fn hit_up(u16 e)    { return solid_h(Entities[e].y - 1,             Entities[e].x, Entities[e].x + Entities[e].w - 1); }

// ---------------- Movement (1 pixel at a time so nothing tunnels) ----------------
fn move_x(u16 e) {
    i16 t = Entities[e].subx + Entities[e].vx;
    i16 dx = t >> 8;
    Entities[e].subx = t & 0xFF;
    while (dx > 0) {
        if (hit_right(e)) {
            Entities[e].vx = 0.0;
            Entities[e].subx = 0;
            Entities[e].dash = 0;
            dx = 0;
        } else {
            Entities[e].x++;
            dx--;
        }
    }
    while (dx < 0) {
        if (hit_left(e)) {
            Entities[e].vx = 0.0;
            Entities[e].subx = 0;
            Entities[e].dash = 0;
            dx = 0;
        } else {
            Entities[e].x--;
            dx++;
        }
    }
}

fn move_y(u16 e) {
    i16 t = Entities[e].suby + Entities[e].vy;
    i16 dy = t >> 8;
    Entities[e].suby = t & 0xFF;
    while (dy > 0) {
        if (hit_down(e)) {
            Entities[e].vy = 0.0;
            Entities[e].suby = 0;
            dy = 0;
        } else {
            Entities[e].y++;
            dy--;
        }
    }
    while (dy < 0) {
        if (hit_up(e)) {
            Entities[e].vy = 0.0;
            Entities[e].suby = 0;
            dy = 0;
        } else {
            Entities[e].y--;
            dy++;
        }
    }
}

