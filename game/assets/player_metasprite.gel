#define PLAYER_ANCHOR_Y -20
#define PLAYER_TILE_COUNT 18
fn player_draw_metasprite(u8 base_x, u8 base_y, u8 attr) {
  if (bit_test(attr, OAMB_HFLIP)) {
    std_draw_sprite(base_x + 16, base_y + 0, 0, attr);
    std_draw_sprite(base_x + 8, base_y + 0, 1, attr);
    std_draw_sprite(base_x + 0, base_y + 0, 2, attr);
    std_draw_sprite(base_x + 16, base_y + 8, 3, attr);
    std_draw_sprite(base_x + 8, base_y + 8, 4, attr);
    std_draw_sprite(base_x + 0, base_y + 8, 5, attr);
    std_draw_sprite(base_x + 16, base_y + 16, 6, attr);
    std_draw_sprite(base_x + 8, base_y + 16, 7, attr);
    std_draw_sprite(base_x + 0, base_y + 16, 8, attr);
    std_draw_sprite(base_x + 16, base_y + 24, 9, attr);
    std_draw_sprite(base_x + 8, base_y + 24, 10, attr);
    std_draw_sprite(base_x + 0, base_y + 24, 11, attr);
    std_draw_sprite(base_x + 16, base_y + 32, 12, attr);
    std_draw_sprite(base_x + 8, base_y + 32, 13, attr);
    std_draw_sprite(base_x + 0, base_y + 32, 14, attr);
    std_draw_sprite(base_x + 16, base_y + 40, 15, attr);
    std_draw_sprite(base_x + 8, base_y + 40, 16, attr);
    std_draw_sprite(base_x + 0, base_y + 40, 17, attr);
    return;
  }
    std_draw_sprite(base_x + 0, base_y + 0, 0, attr);
    std_draw_sprite(base_x + 8, base_y + 0, 1, attr);
    std_draw_sprite(base_x + 16, base_y + 0, 2, attr);
    std_draw_sprite(base_x + 0, base_y + 8, 3, attr);
    std_draw_sprite(base_x + 8, base_y + 8, 4, attr);
    std_draw_sprite(base_x + 16, base_y + 8, 5, attr);
    std_draw_sprite(base_x + 0, base_y + 16, 6, attr);
    std_draw_sprite(base_x + 8, base_y + 16, 7, attr);
    std_draw_sprite(base_x + 16, base_y + 16, 8, attr);
    std_draw_sprite(base_x + 0, base_y + 24, 9, attr);
    std_draw_sprite(base_x + 8, base_y + 24, 10, attr);
    std_draw_sprite(base_x + 16, base_y + 24, 11, attr);
    std_draw_sprite(base_x + 0, base_y + 32, 12, attr);
    std_draw_sprite(base_x + 8, base_y + 32, 13, attr);
    std_draw_sprite(base_x + 16, base_y + 32, 14, attr);
    std_draw_sprite(base_x + 0, base_y + 40, 15, attr);
    std_draw_sprite(base_x + 8, base_y + 40, 16, attr);
    std_draw_sprite(base_x + 16, base_y + 40, 17, attr);
}
