{
    "name":  "snes-gel",
    "displayName":  "SNES-GEL Language Support",
    "description":  "Syntax highlighting and language configuration for SNES-GEL: persist variables, enums, struct tables, bit helpers, inline asm, and the standard library.",
    "version":  "0.3.0",
    "publisher":  "pixelbrownie",
    "icon":  "icon.png",
    "engines":  {
                    "vscode":  "^1.74.0"
                },
    "categories":  [
                       "Programming Languages"
                   ],
    "contributes":  {
                        "languages":  [
                                          {
                                              "id":  "gel",
                                              "aliases":  [
                                                              "SNES-GEL",
                                                              "gel"
                                                          ],
                                              "extensions":  [
                                                                 ".gel"
                                                             ],
                                              "configuration":  "./language-configuration.json",
                                              "icon":  {
                                                           "light":  "./file-icon.png",
                                                           "dark":  "./file-icon.png"
                                                       }
                                          }
                                      ],
                        "grammars":  [
                                         {
                                             "language":  "gel",
                                             "scopeName":  "source.gel",
                                             "path":  "./syntaxes/gel.tmLanguage.json"
                                         }
                                     ],
                        "configuration":  {
                                              "title":  "SNES-GEL",
                                              "properties":  {
                                                                 "gel.parameterNameHints":  {
                                                                                                "type":  "boolean",
                                                                                                "default":  true,
                                                                                                "description":  "Show parameter names before arguments in calls to GEL functions."
                                                                                            }
                                                             }
                                          }
                    },
    "main":  "./extension.js",
    "activationEvents":  [
                             "onLanguage:gel"
                         ]
}
