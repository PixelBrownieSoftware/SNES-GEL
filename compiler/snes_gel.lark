// ==============================================================================
// SNES-GEL EBNF Grammar for Lark
// ==============================================================================

start: item+

?item: global_decl
     | struct_table_decl
     | struct_decl
     | enum_decl
     | extern_decl
     | function_decl

// --- Primitive Types (Priority 2, word boundary so 'u8_count' stays an identifier) ---
TYPE.2: /(u8|i8|u16|i16|f16|f32)\b/

// --- Global Variable & MMIO Declarations ---
storage: "dp"   -> st_dp
       | "mmio" -> st_mmio
       | "persist" -> st_persist
global_decl: storage? TYPE IDENTIFIER ("@" NUMBER)? ("=" expr)? ";"

// Label defined in assembly (e.g. generated asset labels)
extern_decl: "extern" IDENTIFIER ";"

// --- Struct & Struct Table (SoA) Declarations ---
struct_decl: "struct" IDENTIFIER "{" struct_field+ "}" ";"?
struct_field: TYPE IDENTIFIER ";"

// 'interleaved' stores each element's fields together (hardware layouts such as OAM)
struct_table_decl: "struct_table" IDENTIFIER "[" NUMBER "]" ("@" NUMBER)? interleaved? "{" table_field+ "}" ";"?
interleaved: "interleaved"
table_field: TYPE IDENTIFIER ";"

// --- Enum Declarations ---
enum_decl: "enum" IDENTIFIER "{" enum_member ("," enum_member)* ","? "}" ";"?
enum_member: IDENTIFIER ("=" NUMBER)?

// --- Functions ---
function_decl: static_kw? "fn" IDENTIFIER "(" param_list? ")" block
static_kw: "static"
param_list: param ("," param)*
param: TYPE IDENTIFIER ("=" reg_hint)?
reg_hint: "reg" "(" IDENTIFIER ")"

block: "{" statement* "}"

// --- Statements ---
?statement: var_decl_stmt
          | assign_stmt
          | if_stmt
          | switch_stmt
          | while_stmt
          | table_iter_stmt
          | inline_asm_stmt
          | expr_stmt
          | return_stmt

var_decl_stmt: TYPE IDENTIFIER ("=" expr)? ";"
return_stmt: "return" expr? ";"

assign_stmt: target assign_op expr ";"
!assign_op: "=" | "+=" | "-=" | "*=" | "/=" | "&=" | "|=" | "^=" | "<<=" | ">>="

target: IDENTIFIER                              -> var_ref
      | IDENTIFIER "[" expr "]" "." IDENTIFIER  -> field_ref

if_stmt: "if" "(" expr ")" block else_if_clause* else_clause?
else_if_clause: "else" "if" "(" expr ")" block
else_clause: "else" block

switch_stmt: "switch" "(" expr ")" "{" case_clause* default_clause? "}"
case_clause: "case" (NUMBER | IDENTIFIER) ":" statement* "break" ";"
default_clause: "default" ":" statement* ("break" ";")?

while_stmt: "while" "(" expr ")" block

table_iter_stmt: IDENTIFIER "." "for_each" "(" IDENTIFIER ")" block

inline_asm_stmt: "asm" "{" ASM_BODY "}"

expr_stmt: expr ";"

// --- Expressions (operator rules marked '!' keep their operator token) ---
?expr: logic_or

?logic_or: logic_and ("||" logic_and)*
?logic_and: bitwise_or ("&&" bitwise_or)*
?bitwise_or: bitwise_xor ("|" bitwise_xor)*
?bitwise_xor: bitwise_and ("^" bitwise_and)*
?bitwise_and: equality ("&" equality)*

?equality: relational (eq_op relational)*
!eq_op: "==" | "!="
?relational: shift (rel_op shift)*
!rel_op: "<=" | ">=" | "<" | ">"
?shift: additive (shift_op additive)*
!shift_op: "<<" | ">>"
?additive: multiplicative (add_op multiplicative)*
!add_op: "+" | "-"
?multiplicative: unary (mul_op unary)*
!mul_op: "*" | "/"

?unary: "!" unary                     -> logic_not
      | "~" unary                     -> bit_not
      | "-" unary                     -> neg
      | "++" target                   -> pre_inc
      | "--" target                   -> pre_dec
      | target "++"                   -> post_inc
      | target "--"                   -> post_dec
      | primary

?primary: NUMBER                                        -> num
        | FLOAT_LITERAL                                 -> float_num
        | CHAR_LITERAL                                  -> char_num
        | STRING_LITERAL                                -> str_lit
        | REG_READ                                      -> reg_read
        | IDENTIFIER "." "create" "(" ")"               -> table_create
        | IDENTIFIER "[" expr "]" "." "free" "(" ")"    -> table_free
        | IDENTIFIER "(" arg_list? ")"                  -> func_call
        | target
        | "(" expr ")"

arg_list: expr ("," expr)*

// --- Terminals ---
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /0x[0-9a-fA-F]+|[0-9]+/
FLOAT_LITERAL.2: /[0-9]+\.[0-9]+/
CHAR_LITERAL: /'[^'\n]'/
STRING_LITERAL: /"[^"\n]*"/
REG_READ.2: /reg\s*\(\s*[AXY]\s*\)/
ASM_BODY: /[^}]+/

%import common.WS
%ignore WS
